@model IEnumerable<SportsPro.Models.Customer>

@{
    ViewData["Title"] = "Customers Management";
}

<h1>@ViewData["Title"]</h1>


@if(TempData["Message"] != null)
{
    <div class="alert alert-success" role="alert">


        <p>@TempData["Message"]</p>
    </div>
}

<p>
    <a class = "btn btn-primary" asp-action="Create">Create New</a>
</p>

@if(Model.Count() == 0)
{
    <h1>No Customers Found!</h1>
}
else {
    <form method="get" id="sorting">
        <div class="form-group">
            <label as>Sort By</label>
           
            <div>
                <input type="radio" id="SortByFirstNameAsc" name="sorting" value="FirstNameASC" @(ViewBag.CurrSort == "FirstNameASC" ? "checked" : "") />
                <label for="SortByNameAsc">First Name (A-Z)</label>
            </div>
            <div>
                <input type="radio" id="SortByFirstNameDesc" name="sorting" value="FirstNameDESC" @(ViewBag.CurrSort == "FirstNameDESC" ? "checked" : "") />
                <label for="SortByNameDesc">First Name (Z-A)</label>
                </div>

                <div>
                <input type="radio" id="SortByLastNameAsc" name="sorting" value="LastNameASC" @(ViewBag.CurrSort == "LastNameASC" ? "checked" : "") />
                    <label for="SortByCityAsc">Last Name (A-Z)</label>

                    </div>
                    
                    <div>
                <input type="radio" id="SortByLastNameDesc" name="sorting" value="LastNameDESC" @(ViewBag.CurrSort == "LastNameDESC" ? "checked" : "") />
                        <label for="SortByCityDesc">Last Name (Z-A)</label>
                        </div>

                        <div>
                <input type="radio" id="SortByCityAsc" name="sorting" value="CityASC" @(ViewBag.CurrSort == "CityASC" ? "checked" : "") />
                            <label for="SortByEmailAsc">City (A-Z)</label>
                            </div>

                            <div>
                <input type="radio" id="SortByCityDesc" name="sorting" value="CityDESC" @(ViewBag.CurrSort == "CityDESC" ? "checked" : "") />
                                <label for="SortByEmailDesc">City (Z-A)</label>



                

       
        </div>
        <button type="submit" class="btn btn-primary">Apply</button>
    </form>
<table class="table table-bordered">
    <thead>
        <tr>
           <th>
              Full Name
           </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.City)
            </td>
          
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            
            <td>
                <a class = "btn btn-primary" asp-action="Edit" asp-route-id="@item.CustomerId">Edit</a> 
                <a class = "btn btn-info" asp-action="Details" asp-route-id="@item.CustomerId">Details</a> 
                <a class = "btn btn-danger" asp-action="Delete" asp-route-id="@item.CustomerId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<p>Total number of customers is @ViewBag.TotalCustomers</p>
}

<script>
    var sortForm = document.getElementById("sorting")
    var options = document.querySelectorAll("input[type=radio]");

    options.forEach(option => {
        option.addEventListener("change",function() {
            option.submit()
        })
    })
</script>