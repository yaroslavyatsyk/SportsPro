<form method="get" id="filtersForm">

    <div class="form-group">
        <label for="search">Search Products</label>
        <input type="search"
               class="form-control"
               id="search"
               name="search"
               value="@ViewBag.CurrentSearch"
               placeholder="Search" />
    </div>

    <br />

    <div class="form-group">
        <label>Sort by:</label>

        <div class="form-check">
            <input type="radio" name="sortBy" value="name_asc"
                   @(ViewBag.CurrentSortBy == "name_asc" ? "checked" : "") />
            <label>Name (A-Z)</label>
        </div>

        <div class="form-check">
            <input type="radio" name="sortBy" value="name_desc"
                   @(ViewBag.CurrentSortBy == "name_desc" ? "checked" : "") />
            <label>Name (Z-A)</label>
        </div>

        <div class="form-check">
            <input type="radio" name="sortBy" value="price_asc"
                   @(ViewBag.CurrentSortBy == "price_asc" ? "checked" : "") />
            <label>Price (Low to High)</label>
        </div>

        <div class="form-check">
            <input type="radio" name="sortBy" value="price_desc"
                   @(ViewBag.CurrentSortBy == "price_desc" ? "checked" : "") />
            <label>Price (High to Low)</label>
        </div>

        <div class="form-check">
            <input type="radio" name="sortBy" value="release_asc"
                   @(ViewBag.CurrentSortBy == "release_asc" ? "checked" : "") />
            <label>Release Date (Old to New)</label>
        </div>

        <div class="form-check">
            <input type="radio" name="sortBy" value="release_desc"
                   @(ViewBag.CurrentSortBy == "release_desc" ? "checked" : "") />
            <label>Release Date (New to Old)</label>
        </div>

        <div class="form-check">
            <input type="radio" name="sortBy" value="code_asc"
                   @(ViewBag.CurrentSortBy == "code_asc" ? "checked" : "") />
            <label>Product Code (A-Z)</label>
        </div>

        <div class="form-check">
            <input type="radio" name="sortBy" value="code_desc"
                   @(ViewBag.CurrentSortBy == "code_desc" ? "checked" : "") />
            <label>Product Code (Z-A)</label>
        </div>
    </div>

    <br />
    <button type="submit" class="btn btn-secondary">Apply</button>
</form>
<div class="mt-3">
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-sortBy="@ViewBag.CurrentSortBy"
       asp-route-search="@ViewBag.CurrentSearch"
       class="btn btn-outline-primary @(Model.HasPreviousPage ? "" : "disabled")">
        Previous
    </a>

    <span class="mx-2">Page @Model.PageIndex of @Model.TotalPages</span>

    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-sortBy="@ViewBag.CurrentSortBy"
       asp-route-search="@ViewBag.CurrentSearch"
       class="btn btn-outline-primary @(Model.HasNextPage ? "" : "disabled")">
        Next
    </a>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("filtersForm");
        const radios = document.querySelectorAll("input[type=radio]");

        radios.forEach(radio => {
            radio.addEventListener("change", () => form.submit());
        });
    });
</script>