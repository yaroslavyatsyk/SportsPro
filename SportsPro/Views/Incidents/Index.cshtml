@model PaginatedList<Incident>

@{
    ViewData["Title"] = "Incident Management";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        <p>@TempData["Message"]</p>
    </div>
}

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

<form method="get" id="filtersForm">
    <div class="form-group">
        <label for="filter">Filter Incidents</label>
        <select id="filter" name="filtering" class="form-control">
            <option value="">All</option>
            <option value="Unassigned" selected="@(ViewBag.CurrentFiltering == "Unassigned" ? "selected" : null)">Unassigned</option>
            <option value="Opened" selected="@(ViewBag.CurrentFiltering == "Opened" ? "selected" : null)">Opened</option>
            <option value="Resolved" selected="@(ViewBag.CurrentFiltering == "Resolved" ? "selected" : null)">Resolved</option>
        </select>
    </div>

    <br />

    <div class="form-group">
        <label for="sort">Sort Incidents by:</label>
        <select id="sort" name="sorting" class="form-control">
            <option value="">Default</option>

            <option value="Title (A-Z)" selected="@(ViewBag.CurrentSorting == "Title (A-Z)" ? "selected" : null)">Title (A-Z)</option>
            <option value="Title (Z-A)" selected="@(ViewBag.CurrentSorting == "Title (Z-A)" ? "selected" : null)">Title (Z-A)</option>

            <option value="Customer (A-Z)" selected="@(ViewBag.CurrentSorting == "Customer (A-Z)" ? "selected" : null)">Customer (A-Z)</option>
            <option value="Customer (Z-A)" selected="@(ViewBag.CurrentSorting == "Customer (Z-A)" ? "selected" : null)">Customer (Z-A)</option>

            <option value="Product (A-Z)" selected="@(ViewBag.CurrentSorting == "Product (A-Z)" ? "selected" : null)">Product (A-Z)</option>
            <option value="Product (Z-A)" selected="@(ViewBag.CurrentSorting == "Product (Z-A)" ? "selected" : null)">Product (Z-A)</option>

            <option value="DateOpened (A-Z)" selected="@(ViewBag.CurrentSorting == "DateOpened (A-Z)" ? "selected" : null)">Date Opened (A-Z)</option>
            <option value="DateOpened (Z-A)" selected="@(ViewBag.CurrentSorting == "DateOpened (Z-A)" ? "selected" : null)">Date Opened (Z-A)</option>

            <option value="DateClosed (A-Z)" selected="@(ViewBag.CurrentSorting == "DateClosed (A-Z)" ? "selected" : null)">Date Closed (A-Z)</option>
            <option value="DateClosed (Z-A)" selected="@(ViewBag.CurrentSorting == "DateClosed (Z-A)" ? "selected" : null)">Date Closed (Z-A)</option>

            <option value="Technician (A-Z)" selected="@(ViewBag.CurrentSorting == "Technician (A-Z)" ? "selected" : null)">Technician (A-Z)</option>
            <option value="Technician (Z-A)" selected="@(ViewBag.CurrentSorting == "Technician (Z-A)" ? "selected" : null)">Technician (Z-A)</option>
        </select>
    </div>

    <br />
    <button type="submit" class="btn btn-secondary">Apply</button>
</form>

<br />

@if (Model.Count == 0)
{
    <h2>No Incidents Found!</h2>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Product</th>
                <th>Customer</th>
                <th>Opened Date</th>
                <th>Closed Date</th>
                <th>Technician</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Product.Name</td>
                    <td>@item.Customer.FullName</td>
                    <td>@item.DateOpened</td>

                    <td>
                        @(item.DateClosed != null ? item.DateClosed.ToString() : "N/A")
                    </td>

                    <td>
                        @(item.Technician != null ? item.Technician.FullName : "Unassigned")
                    </td>

                    <td>@item.Description</td>

                    <td>
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.IncidentId">Edit</a>
                        <a class="btn btn-info" asp-action="Details" asp-route-id="@item.IncidentId">Details</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.IncidentId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>Total incidents: @ViewBag.TotalIncidents</p>

    <!-- ✅ PAGINATION -->
    <div class="mt-3">
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-filtering="@ViewBag.CurrentFiltering"
           asp-route-sorting="@ViewBag.CurrentSorting"
           class="btn btn-outline-primary @(Model.HasPreviousPage ? "" : "disabled")">
            Previous
        </a>

        <span class="mx-2">Page @Model.PageIndex of @Model.TotalPages</span>

        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-filtering="@ViewBag.CurrentFiltering"
           asp-route-sorting="@ViewBag.CurrentSorting"
           class="btn btn-outline-primary @(Model.HasNextPage ? "" : "disabled")">
            Next
        </a>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("filtersForm");
        const filter = document.getElementById("filter");
        const sort = document.getElementById("sort");

        if (filter) {
            filter.addEventListener("change", () => form.submit());
        }

        if (sort) {
            sort.addEventListener("change", () => form.submit());
        }
    });
</script>