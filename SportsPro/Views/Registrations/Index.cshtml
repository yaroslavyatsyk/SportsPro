@model PaginatedList<SportsPro.Models.Registration>

@{
    ViewData["Title"] = "Index";
}

<h1>Registration Page</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success" role="alert">
        <p>@TempData["Message"]</p>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

@if (Model.Count == 0)
{
    <h1>No Registrations Found!</h1>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Product</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Customer.FullName</td>
                    <td>@item.Product.Name</td>
                    <td>
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.RegistrationId">Edit</a>
                        <a class="btn btn-info" asp-action="Details" asp-route-id="@item.RegistrationId">Details</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.RegistrationId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>Total registrations: @ViewBag.TotalRegistrations</p>

    <div class="mt-3">
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-primary @(Model.HasPreviousPage ? "" : "disabled")">
            Previous
        </a>

        <span class="mx-2">Page @Model.PageIndex of @Model.TotalPages</span>

        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-primary @(Model.HasNextPage ? "" : "disabled")">
            Next
        </a>
    </div>
}