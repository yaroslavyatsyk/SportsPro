@model PaginatedList<SportsPro.Models.Technician>

@{
    ViewData["Title"] = "Technician Management";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success" role="alert">
        <p>@TempData["Message"]</p>
    </div>
}

<p>
    <a class="btn btn-primary" asp-action="Create">Add Technician</a>
</p>

<form method="get" id="filtersForm">
    <div class="form-group">
        <label for="search">Find Technicians</label>
        <input type="search"
               id="search"
               name="search"
               class="form-control"
               value="@ViewBag.CurrentSearch"
               placeholder="Find Technicians" />
    </div>

    <br />

    <div class="form-group">
        <label>Sort by:</label>

        <div>
            <input type="radio" id="SortByFirstNameASC" name="sortBy" value="FirstNameASC"
                   @(ViewBag.CurrentSortBy == "FirstNameASC" ? "checked" : "") />
            <label for="SortByFirstNameASC">First Name ASC</label>
        </div>

        <div>
            <input type="radio" id="SortByFirstNameDESC" name="sortBy" value="FirstNameDESC"
                   @(ViewBag.CurrentSortBy == "FirstNameDESC" ? "checked" : "") />
            <label for="SortByFirstNameDESC">First Name DESC</label>
        </div>

        <div>
            <input type="radio" id="SortByLastNameASC" name="sortBy" value="LastNameASC"
                   @(ViewBag.CurrentSortBy == "LastNameASC" ? "checked" : "") />
            <label for="SortByLastNameASC">Last Name ASC</label>
        </div>

        <div>
            <input type="radio" id="SortByLastNameDESC" name="sortBy" value="LastNameDESC"
                   @(ViewBag.CurrentSortBy == "LastNameDESC" ? "checked" : "") />
            <label for="SortByLastNameDESC">Last Name DESC</label>
        </div>
    </div>

    <br />
    <button type="submit" class="btn btn-secondary">Apply</button>
</form>

<br />

@if (Model.Count == 0)
{
    <h1>There are no technicians to display.</h1>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.TechnicianId">Edit</a>
                        <a class="btn btn-info" asp-action="Details" asp-route-id="@item.TechnicianId">Details</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.TechnicianId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>Total amount of records: @ViewBag.TotalTechnicians</p>

    <div class="mt-3">
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-sortBy="@ViewBag.CurrentSortBy"
           asp-route-search="@ViewBag.CurrentSearch"
           class="btn btn-outline-primary @(Model.HasPreviousPage ? "" : "disabled")">
            Previous
        </a>

        <span class="mx-2">Page @Model.PageIndex of @Model.TotalPages</span>

        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-sortBy="@ViewBag.CurrentSortBy"
           asp-route-search="@ViewBag.CurrentSearch"
           class="btn btn-outline-primary @(Model.HasNextPage ? "" : "disabled")">
            Next
        </a>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("filtersForm");
        const radios = document.querySelectorAll("input[type=radio]");

        radios.forEach(radio => {
            radio.addEventListener("change", function () {
                form.submit();
            });
        });
    });
</script>