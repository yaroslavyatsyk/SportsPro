@model IEnumerable<SportsPro.Models.Technician>

@{
    ViewData["Title"] = "Technician Management";
}

<h1>@ViewData["Title"]</h1>

@if(TempData["Message"] != null)
{
    <div class="alert alert-success" role="alert">
        <p>@TempData["Message"]</p>
    </div>
}

<p>
    <a class="btn btn-primary" asp-action="Create">Add Technician</a>
</p>

@if(Model.Count() == 0)
{
    <h1>There are no technicians to display.</h1>
}
else
{
    <form method="get" id="searching">
        <div class="class-group">
            <input type="search" id="search" name="search" placeholder="Find Technicianes" />

        </div>
    </form>
    <form method="get" id="sortingForm">
       
        <div class="class-group">
            <input type = "radio" id="SortByFirstNameASC" name="sortBy" value="FirstNameASC" @(ViewBag.CurrSort == "FirstNameASC" ? "checked" : "") />
            <label for="SortByFirstNameASC">First Name ASC</label>
        </div>
        <div class="class-group">
            <input type = "radio" id="SortByFirstNameDESC" name="sortBy" value="FirstNameDESC" @(ViewBag.CurrSort == "FirstNameDESC" ? "checked" : "") />
            <label for="SortByFirstNameDESC">First Name DESC</label>
            </div>
            <div class="class-group">
                <input type = "radio" id="SortByLastNameASC" name="sortBy" value="LastNameASC" @(ViewBag.CurrSort == "LastNameASC" ? "checked" : "") />
                <label for="SortByLastNameASC">Last Name ASC</label>
                </div>
                <div class="class-group">
            <input type="radio" id="SortByLastNamedesc" name="sortBy" value="LastNameDESC" @(ViewBag.CurrSort == "LastNameDESC" ? "checked" : "") />
            <label for="SortByLastNameASC">Last Name DESC</label>
                </div>

               

    </form>
    

<table class="table table-bordered">
    <thead>
        <tr>
           <th>
               Full Name
           </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                
<td>
                    @Html.DisplayFor(modelItem => item.FullName)
</td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
               
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.TechnicianId">Edit</a> 
                    <a class="btn btn-info" asp-action="Details" asp-route-id="@item.TechnicianId">Details</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.TechnicianId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<p>Total amount of records @ViewBag.TotalTechnicians</p>
}

<script>
    var sortingForm = document.getElementById("sortingForm");

    var radios = sortingForm.querySelectorAll("input[type=radio]");

    radios.forEach(radio => {
        radio.addEventListener("change", function () {
            sortingForm.submit();
        })
        })
</script>